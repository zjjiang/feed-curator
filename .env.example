# 复制为 .env 并填入真实值(.env 不会被提交)。
#
# === 本机直跑(当前部署方式)===
# 数据库为本机 MySQL 的 feed_curator 库(重建后的 13 张新表)。
# 用 127.0.0.1 而非 localhost。不设置 DATABASE_URL 时 app 回退到
# 本地 SQLite(data/feed-curator.db,迁移后该文件已删除,回退只会得到空库)。
DATABASE_URL="mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/feed_curator?charset=utf8mb4"

# we-mp-rss(微信公众号 feed)地址。未运行时 wechat 管道会采集失败,不影响其他管道。
WEWE_BASE_URL="http://localhost:9001"

# DeepSeek API key。留空则只抓取、不做 AI 判定(调度与分析入口会明确提示未配置)。
DEEPSEEK_API_KEY=""

# 出网代理(适配器与全文抓取统一走 app/utils/outbound.py)。
# OUTBOUND_PROXY:完整代理地址,如 http://127.0.0.1:7897;优先级最高。
# CLASH_PROXY_PORT:本机 Clash 混合端口,自动展开为 http://127.0.0.1:<端口>。
# 两者都未设置时回退标准 HTTPS_PROXY/HTTP_PROXY/ALL_PROXY,再无则全直连。
# 境外源(arxiv 等)代理优先、连接失败直连回退;国内可达源(hf-mirror.com)直连优先。
OUTBOUND_PROXY=""
CLASH_PROXY_PORT=""
